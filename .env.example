# Backend — copy to .env in project root (never commit .env)

# Local Docker Postgres
DATABASE_URL=postgresql+psycopg2://fitwise:fitwise@localhost:5432/fitwise

# Production Neon example (use in Render dashboard only, not locally):
# DATABASE_URL=postgresql+psycopg2://user:pass@host/neondb?sslmode=require

GROQ_API_KEY=
# llama-3.3-70b-versatile (local quality) or llama-3.1-8b-instant (lower tokens / prod)
GROQ_MODEL=llama-3.3-70b-versatile
JWT_SECRET=change-me-to-a-long-random-string

# Production frontend URL — set on Render (e.g. https://fitwise-ai.vercel.app)
FRONTEND_URL=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fitwise-ai

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8001

# OAuth callback URLs to register:
# Local:  http://localhost:3000/login/github/callback
# Prod:   https://YOUR-APP.vercel.app/login/github/callback
